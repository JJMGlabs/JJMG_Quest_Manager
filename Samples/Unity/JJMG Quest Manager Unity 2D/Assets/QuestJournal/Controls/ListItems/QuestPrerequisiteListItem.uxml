<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style>

    </ui:Style>
    <ui:VisualElement name="HeaderRow" class="subObjectLstItmRow subObjectHeaderRow">
        <ui:VisualElement class="leftColumn">
            <ui:Label tabindex="-1" name="HeaderName" text="Name" parse-escape-sequences="true" display-tooltip-when-elided="true" class="subObjectHeaderLabel" />
        </ui:VisualElement>
        <ui:VisualElement class="rightColumn rightInnerColumn">
            <ui:Label tabindex="-1" name="HeaderStatus" text="Status" parse-escape-sequences="true" display-tooltip-when-elided="true" class="subObjectHeaderLabel" />
            <ui:Label tabindex="-1" name="HeaderValue" text="Value" parse-escape-sequences="true" display-tooltip-when-elided="true" class="subObjectHeaderLabel" />
            <ui:Label tabindex="-1" name="HeaderProgress" text="Progress" parse-escape-sequences="true" display-tooltip-when-elided="true" class="subObjectHeaderLabel" />
            <ui:Label tabindex="-1" name="HeaderTarget" text="Target" parse-escape-sequences="true" display-tooltip-when-elided="true" class="subObjectHeaderLabel" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="DataRow" class="subObjectLstItmRow">
        <ui:VisualElement class="leftColumn">
            <ui:Label tabindex="-1" name="Name" parse-escape-sequences="true" display-tooltip-when-elided="true" />
        </ui:VisualElement>
        <ui:VisualElement class="rightColumn rightInnerColumn">
            <ui:Label tabindex="-1" name="Status" parse-escape-sequences="true" display-tooltip-when-elided="true" />
            <ui:Label tabindex="-1" name="PrerequisiteValue" parse-escape-sequences="true" display-tooltip-when-elided="true" />
            <ui:Label tabindex="-1" name="PrerequisiteProgress" parse-escape-sequences="true" display-tooltip-when-elided="true" />
            <ui:Label tabindex="-1" name="PrerequisiteTarget" parse-escape-sequences="true" display-tooltip-when-elided="true" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>